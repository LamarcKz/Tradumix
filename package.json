{
  "name": "tradumix",
  "productName": "Tradumix",
  "version": "0.1.0",
  "description": "Aplica traduções de jogos de PS2 na sua ISO, preservando o hash do RetroAchievements.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "xdelta3": "node scripts/baixar-xdelta3.mjs",
    "dev": "tauri dev",
    "web:dev": "vite",
    "web:build": "vite build",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "npm run typecheck && npm run test:unit && npm run test:rust",
    "test:unit": "vitest run",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26",
    "lucide-react": "^1.47.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
