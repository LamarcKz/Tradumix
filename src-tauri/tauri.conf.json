{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tradumix",
  "mainBinaryName": "Tradumix",
  "version": "../package.json",
  "identifier": "io.github.tradumix",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tradumix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MThBRjE5MkUzMzExMUQKUldRZEVUTXVHYThZVkxDb3ZMN1ZObFlXVmZ6SjRBSmZsWGhnUEtiSW1SUXk1Qk5yWE1oTk1GR3QK",
      "endpoints": ["https://github.com/LamarcKz/Tradumix/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "Traduções de jogos de PS2 que preservam o hash do RetroAchievements.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/xdelta3"],
    "resources": { "licencas/xdelta3-LICENSE.txt": "licencas/xdelta3-LICENSE.txt" }
  }
}
